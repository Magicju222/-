# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-publishable-key-here"
SUPABASE_SERVICE_KEY="your-secret-key-here"

# Project Settings
PROJECT_NAME="AI Excel Cleaner Admin API"

# LLM Configuration for AI Data Analysis
# 提供商选项: openai, gemini, moonshot
LLM_PROVIDER="moonshot"

# API Key - 根据提供商选择:
# - Moonshot (Kimi): 从 https://platform.moonshot.cn/console/api-keys 获取 (以 sk- 开头)
# - Gemini: 从 https://aistudio.google.com/app/apikey 获取 (以 AIzaSy 开头)
# - OpenAI: 从 https://platform.openai.com/api-keys 获取 (以 sk- 开头)
LLM_API_KEY="your-api-key-here"

# API Base URL (可选,根据提供商自动设置)
# - Moonshot: https://api.moonshot.cn/v1
# - OpenAI: https://api.openai.com/v1
# - Gemini: 不需要设置
LLM_BASE_URL=""

# 模型名称 - 根据提供商选择:
# Moonshot (Kimi) 推荐模型:
#   - kimi-k2-5 (Kimi K2.5, 最新模型,推荐)
#   - moonshot-v1-8k (8K上下文)
#   - moonshot-v1-32k (32K上下文)
#   - moonshot-v1-128k (128K上下文)
# Gemini 推荐模型:
#   - gemini-2.0-flash (最新快速)
#   - gemini-2.0-flash-lite (轻量版)
# OpenAI 推荐模型:
#   - gpt-4
#   - gpt-4-turbo
#   - gpt-3.5-turbo
LLM_MODEL="kimi-k2-5"

# 其他配置
LLM_MAX_RETRIES="3"
LLM_TIMEOUT="60"
LLM_RATE_LIMIT="20"

# Optional: Image Generation API (DALL-E)
IMAGE_GEN_API_KEY="your-dalle-api-key-here"
